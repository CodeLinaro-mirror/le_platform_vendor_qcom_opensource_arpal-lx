cc_library_headers {

    name: "libstream_acd_headers",
    export_include_dirs: ["inc"],
    vendor: true,

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}

cc_library {
    name: "libstream_acd",
    owner: "qti",
    vendor: true,

    srcs: [
         "src/StreamACD.cpp",
         "src/ContextDetectionEngine.cpp",
         "src/ACDEngine.cpp",
         ],

    shared_libs: [
         "liblog",
         "libcutils",
         "liblx-osal",
         "libar-pal",
         "libexpat",
         "libar-gsl",
         "libsession_ar",
         "libaudioroute",
         ], 

    include_dirs: [
         "vendor/qcom/opensource/pal/stream/StreamACD/inc",
         "system/media/audio_route/include",
         "vendor/qcom/opensource/pal",
         ],

    cflags: [
         "-DACD_SM_FILEPATH=\"/vendor/etc/models/acd/\""
         ],

    cppflags: [
         "-fexceptions",  "-frtti",
         ],

    rtti: true,

    header_libs: [
         "libarpal_headers",
         "libspf-headers",
         "libvui_dmgr_headers",
         "libarvui_intf_headers",
         "libaudiofeaturestats_headers",
         "liblisten_headers",
         "libacdb_headers",
         "libarpal_internalheaders",
         "libarmemlog_headers",
         "libsession_ar_headers",
         ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}

