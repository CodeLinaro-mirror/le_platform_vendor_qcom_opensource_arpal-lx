cc_library_headers {

    name: "libstream_common_headers",
    export_include_dirs: ["inc"],
    vendor: true,

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}

cc_library {

    name: "libstream_common",
    owner: "qti",
    vendor: true,

    srcs: [
       "src/StreamCommon.cpp",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "liblx-osal",
        "libar-pal",
        "libexpat",
        "libar-gsl",
        "libaudioroute",
        ], 

    include_dirs: [
        "vendor/qcom/opensource/pal/stream/StreamCommon/inc",
        "system/media/audio_route/include",
        "vendor/qcom/opensource/pal",
        ],

    cppflags: [
        "-fexceptions", "-frtti",
        ],

    header_libs: [
        "libstream_common_headers",
        "libarpal_headers",
        "libspf-headers",
        "libvui_dmgr_headers",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "liblisten_headers",
        "libacdb_headers",
        "libarpal_internalheaders",
        "libarmemlog_headers",
        ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}

subdirs= ["*"]