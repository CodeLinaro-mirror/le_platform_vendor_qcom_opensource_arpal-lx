cc_library_shared {

    name: "lib_bt_bundle",
    owner: "qti",
    vendor: true,

    srcs: [
        "bt_base.c",
        "bt_bundle.c"
        ],

    shared_libs: [
        "libcutils",
        "liblog",
        "libdl"
        ],

    include_dirs: [
        "system/media/audio/include"
        ],

    cflags: [
            "-O2",
            "-fvisibility=hidden",
            "-Wall",
            "-Werror",
            ]
        + select(soong_config_variable("qti", "AUDIO_FEATURE_ENABLE_BT_A2DP_LPI"), {
            true: ["-DBT_A2DP_LPI_ENABLED"],
            default: [],
        }),

    header_libs: [
        "libspf-headers",
        "libarosal_headers"
        ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}


