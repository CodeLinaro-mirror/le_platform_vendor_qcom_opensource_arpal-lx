cc_library_headers {

    name: "plugin_manager_headers",
    export_include_dirs: ["inc"],
    vendor: true,

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}

cc_library_static {
    name: "libplugin_manager",
    owner: "qti",
    vendor: true,

    cppflags: ["-fexceptions"],

    srcs: select(soong_config_variable("qti", "USE_PAL_STATIC_LINKING_MODULES"), {
        true: ["src/PluginManagerStatic.cpp"],
        default: ["src/PluginManager.cpp"],
    }),

    cflags: select(soong_config_variable("qti", "USE_PAL_STATIC_LINKING_MODULES"), {
        true: ["-DUSE_STATIC_LINKING_MODULES"],
        default: [],
    }),

    include_dirs: [
        "system/media/audio_route/include",
        "vendor/qcom/opensource/args/ar_osal/api",
        "vendor/qcom/opensource/pal",
    ]   + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
            true: [],
            default: ["external/tinycompress/include"],
    })  + select(soong_config_variable("qti", "USE_PAL_STATIC_LINKING_MODULES"), {
            true: ["system/media/audio/include", "system/media/audio_route/include"],
            default: [],
    }),

    shared_libs: [
        "liblog",
        "libcutils",
        "liblx-osal",
        "libexpat",
    ] + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
        true: ["libqti-tinyalsa", "libqti-tinycompress"],
        default: ["libtinyalsa", "libtinycompress"],
    }),

    header_libs: [
        "libarpal_headers",
        "libarpal_internalheaders",
        "libarvui_intf_headers",
        "liblisten_headers",
    ] + select(soong_config_variable("qti", "USE_PAL_STATIC_LINKING_MODULES"), {
        true: [
            "libspf-headers",
            "libvui_dmgr_headers",
            "libaudiofeaturestats_headers",
            "libacdb_headers",
            "libagm_headers",
            "libaudioroute",
            "libarpal_internalheaders",
            "libarmemlog_headers",
            "libstream_acd_headers",
            "libstream_acdb_headers",
            "libstream_common_headers",
            "libstream_commonproxy_headers",
            "libstream_compress_headers",
            "libstream_contextproxy_headers",
            "libstream_haptics_headers",
            "libstream_incall_headers",
            "libstream_nontunnel_headers",
            "libstream_pcm_headers",
            "libstream_sensorpcmdata_headers",
            "libstream_sensorrenderer_headers",
            "libstream_soundtrigger_headers",
            "libstream_ultrasound_headers",
            "libstream_asr_headers",
            "libsession_ar_headers",
            "libsession_agm_headers",
            "libsession_compress_headers",
            "libsession_voice_headers",
            "libsession_pcm_headers",
            "libdev_bt_headers",
            "libdev_display_headers",
            "libdev_dummy_headers",
            "libdev_ecref_headers",
            "libdev_extec_headers",
            "libdev_fm_headers",
            "libdev_handset_headers",
            "libdev_handsetmic_headers",
            "libdev_handsetva_headers",
            "libdev_haptics_headers",
            "libdev_headphone_headers",
            "libdev_headsetmic_headers",
            "libdev_headsetva_headers",
            "libdev_proxy_headers",
            "libdev_speaker_headers",
            "libdev_speakermic_headers",
            "libdev_a2bmic",
            "libdev_a2bspeaker",
            "libdev_a2b2mic",
            "libdev_a2b2speaker",
            "libdev_ultrasound_headers",
            "libdev_usb_headers",
            "libdev_hfpdownlink_headers",
            "libdev_hfpuplink_headers",
        ],
        default: [],
    }),

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}

