cc_library_shared {

    name: "libcustomva_intf",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/CustomVAInterface.cpp"
        ],

    shared_libs: [
        "liblog",
        "libcutils",
        "liblx-osal",
        ],

    include_dirs: [
        "vendor/qcom/opensource/pal/plugins/customva_intf/inc",
        ],

    cppflags: [
        "-fexceptions",
        ],

    header_libs: [
        "libarpal_headers",
        "libarvui_intf_headers",
        "libspf-headers",
        "liblisten_headers",
        "libarosal_headers",
        ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}


