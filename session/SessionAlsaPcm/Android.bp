cc_library_headers {

    name: "libsession_pcm_headers",
    export_include_dirs: ["inc"],
    vendor: true,

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}

cc_library {

    name: "libsession_pcm",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/SessionAlsaPcm.cpp",
        ],

    shared_libs: [
            "liblog",
            "liblx-osal",
            "libar-pal",
            "libexpat",
            "libagmclient",
            "libaudioroute",
            "libsession_ar"
            ]
        + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
            true: ["libqti-tinyalsa", "libqti-tinycompress"],
            default: ["libtinyalsa", "libtinycompress"],
        }),

    include_dirs: [
            "vendor/qcom/opensource/pal/session/SessionAlsaPcm/inc",
            "system/media/audio_route/include",
            "vendor/qcom/opensource/pal",
            ]
        + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
            true: [],
            default: ["external/tinycompress/include"],
        }),

    cflags: [ ]
        + select(soong_config_variable("qti", "TARGET_AUTO_RBVM"), {
            true: ["-DSKIP_INITIAL_VOLUME"],
            default: [],
        }),
    cppflags: [
            "-fexceptions", "-frtti", "-Wno-macro-redefined",
            ],

    rtti: true,

    header_libs: [
        "libarpal_headers",
        "libspf-headers",
        "libagm_headers",
        "libacdb_headers",
        "liblisten_headers",
        "libaudiofeaturestats_headers",
        "libarvui_intf_headers",
        "libarmemlog_headers",
        "libarpal_internalheaders",
        "libsession_ar_headers",
        ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",
}

